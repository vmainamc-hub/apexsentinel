# Apex Sentinel — Netlify environment variables (server-side only; never prefix with VITE_).

# Deriv OAuth2 application registered for this site.
DERIV_OAUTH_CLIENT_ID=your-deriv-oauth-client-id
DERIV_APP_ID=your-deriv-app-id
# Must equal the redirect URI registered in the Deriv app: <SITE_ORIGIN>/api/deriv-oauth-callback
SITE_ORIGIN=https://peppy-starship-b80f54.netlify.app
# Optional overrides
# DERIV_REDIRECT_URI=
# DERIV_ALLOWED_SCOPES=trade
# SITE_ID=apex-sentinel

# 32 random bytes, base64url. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=generate-a-32-byte-base64url-key

# Express/PostgreSQL backend (new-user-interface-main/backend, e.g. on Render) — bot ideas, best-bot stats, scanner.
